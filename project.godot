; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="jame gam"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TransitionManager="*uid://djf3vismjcx4s"

[display]

window/size/viewport_width=384
window/size/viewport_height=288
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-hackatime/plugin.cfg", "res://addons/godot-hackatime/tracker/plugin.cfg")

[global_group]

Konpeito=""

[gui]

theme/custom_font="uid://cbflvdr6x3gcs"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
