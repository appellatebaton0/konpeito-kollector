[sub_resource type="GDScript" id="GDScript_dhcmq"]
script/source = "@tool
extends SubViewport


func _ready() -> void:
	for child in get_children():
		if child is Node2D:
			for grand in child.get_children():
				
				grand.rotate(randf() * TAU)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	
	
	for child in get_children():
		if child is Node2D:
			for grand in child.get_children():
				
				grand.rotate(0.01)
	
	pass
"

